# Export optional overrides in your shell; no .env loader is used.
# These public values are already configured in vertex_settings.json.
LLM_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=rag-project-494802
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# Sign in with gcloud auth application-default login, then:
# gcloud auth application-default set-quota-project rag-project-494802
# Never put credentials into this file or frontend JavaScript.
# Alternative provider:
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Optional override for the local SQLite run/feedback store.
# DEMO_DB_PATH=/absolute/path/demo.sqlite3
